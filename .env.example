DATASOURCE_EXPIRATIONS=86400000
DATASOURCE_SECRET=yoursecretkey
DATASOURCE_COOKIE=springBootMoneyManager


#Email Configuration
DATASOURCE_MAIL_HOST=smtp-relay.brevo.com
DATASOURCE_MAIL_PORT=587
